<article class="rive-page-view">
    {{#if data.title.show}}
    <header class="journal-page-header">
        <h{{data.title.level}}>{{data.name}}</h{{data.title.level}}>
    </header>
    {{/if}}
    <figure class="rive-figure">
        <div class="rive-stage" style="aspect-ratio: {{stageRatio}}">
            <canvas class="rive-canvas"></canvas>
        </div>
        <p class="rive-status"></p>
        {{#if system.caption}}<figcaption>{{system.caption}}</figcaption>{{/if}}
    </figure>
    {{#if isGM}}
    <details class="rive-live">
        <summary>{{localize "FOUNDRY_RIVE.LiveControls"}}</summary>
        <p class="hint">{{localize "FOUNDRY_RIVE.LiveHint"}}</p>
        <p class="hint rive-live-note"></p>
        <div class="rive-live-controls"></div>
        <button type="button" class="rive-live-save">
            <i class="fa-solid fa-floppy-disk"></i> {{localize "FOUNDRY_RIVE.LiveSave"}}
        </button>
    </details>
    {{/if}}
</article>
